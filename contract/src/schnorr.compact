module schnorr {
  import CompactStandardLibrary;

  // Temporary Jubjub Schnorr verifier. Replace with the standard-library
  // verifier when it becomes available in the supported Compact release.
  export struct SchnorrSignature {
    announcement: JubjubPoint;
    response: Field;
  }

  struct SchnorrHashInput<#n> {
    ann_x: Field;
    ann_y: Field;
    pk_x: Field;
    pk_y: Field;
    msg: Vector<n, Field>;
  }

  witness getSchnorrReduction(challengeHash: Field): [Field, Uint<248>];

  export circuit schnorrVerify<#n>(
    msg: Vector<n, Field>,
    signature: SchnorrSignature,
    pk: JubjubPoint
  ): [] {
    const { announcement, response } = signature;
    const challengeHash: Field = transientHash<SchnorrHashInput<n>>(
      SchnorrHashInput<n> {
        ann_x: jubjubPointX(announcement),
        ann_y: jubjubPointY(announcement),
        pk_x: jubjubPointX(pk),
        pk_y: jubjubPointY(pk),
        msg: msg
      }
    );

    const TWO_248: Field =
      452312848583266388373324160190187140051835877600158453279131187530910662656 as Field;
    const [quotient, reducedChallenge] = getSchnorrReduction(challengeHash);

    assert(
      disclose(quotient) * TWO_248 + (disclose(reducedChallenge) as Field) == challengeHash,
      "Invalid challenge reduction"
    );

    const challenge: Field = disclose(reducedChallenge) as Field;
    const lhs: JubjubPoint = ecMulGenerator(response);
    const rhs: JubjubPoint = ecAdd(announcement, ecMul(pk, challenge));

    assert(
      jubjubPointX(lhs) == jubjubPointX(rhs) &&
        jubjubPointY(lhs) == jubjubPointY(rhs),
      "Invalid lab certificate signature"
    );
  }

  export pure circuit schnorrChallenge(
    ann_x: Field,
    ann_y: Field,
    pk_x: Field,
    pk_y: Field,
    msg: Vector<4, Field>
  ): Field {
    return transientHash<SchnorrHashInput<4>>(
      SchnorrHashInput<4> {
        ann_x: ann_x,
        ann_y: ann_y,
        pk_x: pk_x,
        pk_y: pk_y,
        msg: msg
      }
    );
  }
}
